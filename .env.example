# Local PostgreSQL (used only when DATABASE_URL is not a Neon URL)
POSTGRES_DB=binutech
POSTGRES_USER=binutech
POSTGRES_PASSWORD=change-me

# Neon PostgreSQL
# Copy this value from the Neon dashboard's connection details.
# Keep sslmode=require. Do not commit the real password or this file.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# API
API_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_INIT_EMAIL=admin@biniyam.local
ADMIN_INIT_PASSWORD=change-me

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

